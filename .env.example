# ─── Binance Futures API ────────────────────────────────────────────────────────
# Create keys at https://www.binance.com/en/my/settings/api-management
# Important: on Binance, restrict the key to your server's IP address!
# For paper trading, leave these blank — the bot will run in dry-run (mock) mode.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ─── Web Dashboard Auth ─────────────────────────────────────────────────────────
# Change these BEFORE deploying. Access is protected by HTTP Basic Auth.
WEB_USER=admin
WEB_PASS=CHANGE_ME_BEFORE_LAUNCH

# ─── Web Server ─────────────────────────────────────────────────────────────────
# Port the FastAPI dashboard will listen on inside the container.
WEB_PORT=6594

# ─── Redis Connection ────────────────────────────────────────────────────────────
# When running locally:   REDIS_HOST=localhost
# When running in Docker: REDIS_HOST=redis   (matches docker-compose service name)
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Logging ────────────────────────────────────────────────────────────────────
# Path to the main rotating log file (relative to the project root).
LOG_PATH=logs/quant_system.log
# Maximum lines returned by /api/logs endpoint.
LOG_TAIL_LINES=120
